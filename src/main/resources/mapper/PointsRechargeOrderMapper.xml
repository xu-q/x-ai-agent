<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.x.xaiagent.mapper.PointsRechargeOrderMapper">

    <!-- 按业务单号查询（自定义 SQL 需手动带 deleted=0） -->
    <select id="selectByOrderNo" resultType="com.x.xaiagent.entity.PointsRechargeOrder">
        SELECT *
        FROM points_recharge_order
        WHERE order_no = #{orderNo}
          AND deleted = 0
    </select>

</mapper>
